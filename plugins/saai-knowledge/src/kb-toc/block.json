{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "saai-knowledge/kb-toc",
	"title": "KB Table of Contents",
	"category": "widgets",
	"description": "In-page table of contents generated from the article's headings, with scroll-spy highlighting.",
	"textdomain": "saai-knowledge",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-view.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	}
}
