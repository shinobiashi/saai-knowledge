{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "saai-knowledge/product-docs",
	"title": "Product Documentation",
	"category": "woocommerce",
	"icon": "media-document",
	"description": "Links to the knowledge base articles linked to a product. Uses the product being displayed unless one is chosen.",
	"keywords": [ "product", "documentation", "knowledge base" ],
	"textdomain": "saai-knowledge-for-woocommerce",
	"usesContext": [ "postId", "queryId" ],
	"attributes": {
		"productId": {
			"type": "number",
			"default": 0
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	}
}
